# ═══════════════════════════════════════════════
#   DMS SEKOLAH — Environment Variables Example
# ═══════════════════════════════════════════════
# Salin file ini menjadi .env dan isi nilainya
# cp .env.example .env

# ─────────────────── App ───────────────────────
APP_NAME="DMS Sekolah"
APP_VERSION="1.0.0"
APP_ENV=development                        # development | staging | production
DEBUG=true
SECRET_KEY=your-super-secret-key-min-32-chars-change-this
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# ─────────────────── Database ──────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dms_sekolah
POSTGRES_USER=dms_user
POSTGRES_PASSWORD=your-strong-db-password
DATABASE_URL=postgresql+asyncpg://dms_user:your-strong-db-password@postgres:5432/dms_sekolah

# ─────────────────── Redis ─────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@redis:6379/0

# ─────────────────── MinIO ─────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-minio-password-min-8-chars
MINIO_BUCKET_DOCUMENTS=dms-documents
MINIO_BUCKET_AVATARS=dms-avatars
MINIO_USE_SSL=false

# ─────────────────── JWT ───────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────── Email ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@dms-sekolah.id
EMAIL_FROM_NAME="DMS Sekolah"

# ─────────────────── ML / NeuralKeyGen ─────────
ML_MODEL_PATH=/ml_model/model.pt
ML_DEVICE=cpu                              # cpu | cuda
ML_KEY_LENGTH=32
ML_BATCH_SIZE=16
ENABLE_ANOMALY_DETECTION=true

# ─────────────────── Frontend ──────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="DMS Sekolah"
NEXT_PUBLIC_APP_VERSION=1.0.0

# ─────────────────── Logging ───────────────────
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                            # json | text

# ─────────────────── SINDAS Integration ────────
# SINDAS = Sistem Informasi Data Sekolah (API REST eksternal)
SINDAS_ENABLED=true                        # true | false
SINDAS_API_BASE_URL=https://sindas.disdik.xxx.go.id/api  # URL base API SINDAS
SINDAS_API_KEY=your-sindas-api-key         # API Key untuk pull data aktif dari SINDAS
SINDAS_WEBHOOK_SECRET=your-webhook-secret-min-32-chars   # Secret untuk verifikasi signature webhook
SINDAS_DEFAULT_SEKOLAH_ID=1               # Fallback sekolah_id jika tidak ada di payload webhook

# ─────────────────── Backup ───────────────────
BACKUP_ENCRYPTION_KEY=GANTI_DENGAN_64_CHAR_HEX_RANDOM
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_RESTORE_BYTES=2147483648
